# ---------- ÜRETİM (Vercel Environment Variables) ----------
# Cloud Run deploy sonrası verilen URL (sonunda / yok). Backend CORS: https://ongunbiotech.com
VITE_API_BASE_URL=https://backend-service-635662286956.europe-west1.run.app
# Backend GOOGLE_CLIENT_ID ile aynı Web client
VITE_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# ---------- YEREL (npm run dev) ----------
# VITE_API_BASE_URL boş → /api istekleri Vite proxy ile 127.0.0.1:8080
# VITE_DEV_BACKEND_URL=http://127.0.0.1:8080

# ---------- Firebase (Vercel + .env.local) — backend’e bağlanmaz; tarayıcı doğrudan kullanır ----------
# Project settings → Your apps → Web
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=ongunbiotech.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=ongunbiotech
# VITE_FIREBASE_STORAGE_BUCKET=ongunbiotech.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=   # Analytics (isteğe bağlı)
